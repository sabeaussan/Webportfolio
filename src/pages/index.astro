---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpaceScene from '../components/SpaceScene.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { formatDate, sortNotes, sortProjects } from '../lib/content';
const notes = sortNotes(await getCollection('notes', ({ data }) => !data.draft)).slice(0, 3);
const projects = sortProjects(await getCollection('projects', ({ data }) => !data.draft)).slice(0, 3);
const url = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker"><span>Personal log</span><span>Sector 03</span></p>
      <h1>Following my <br/><em>curiosity</em>  & sharing odd <em>ideas</em> .<br/></h1>
      <p class="hero-intro">{site.description}</p>
    </div>
    <SpaceScene />
    <p class="coordinates" aria-hidden="true">48.8566° N<br/>2.3522° E</p>
  </section>

  <section class="transmissions section-rule">
    <div class="section-heading">
      <div><p class="eyebrow">Incoming signal</p><h2>Latest transmissions</h2></div>
      <a class="text-link" href={url('/notes/')}>View all notes <span>→</span></a>
    </div>
    <div class="note-list">
      {notes.map((note) => (
        <a class="note-row" href={url(`/notes/${note.id}/`)}>
          <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
          <div><h3>{note.data.title}</h3><p>{note.data.description}</p></div>
          <span class="note-category">{note.data.category}</span><span class="arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="project-section section-rule">
    <div class="section-heading centered">
      <div><p class="eyebrow">Selected missions</p><h2>Projects</h2></div>
      <a class="text-link" href={url('/projects/')}>All expeditions <span>→</span></a>
    </div>
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
  </section>

  <section class="contact-strip section-rule">
    <span class="contact-planet" aria-hidden="true"></span>
    <p class="eyebrow">Long-range communications</p>
    <h2>Have an interesting idea<br/>on your radar?</h2>
    <a class="button" href={`mailto:${site.email}`}>Send a transmission <span>↗</span></a>
  </section>
</BaseLayout>
