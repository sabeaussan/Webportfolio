---
import { site } from '../data/site';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const links = [
  { href: '/about/', label: 'Me, Myself & I' },
  { href: '/notes/', label: 'Ideas' },
  { href: '/projects/', label: 'Projects' },
];
const url = (href: string) => `${import.meta.env.BASE_URL}${href.replace(/^\//, '')}`;
---
<header class="site-header">
  <a class="wordmark" href={url('/')} aria-label={`${site.name}, home`}>
    <span class="wordmark-dot" aria-hidden="true"></span>{site.name}
  </a>
  <nav aria-label="Main navigation">
    {links.map((link) => (
      <a href={url(link.href)} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>
